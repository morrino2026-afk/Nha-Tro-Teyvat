# ===========================================================
# Mộng Nguyệt Studio — biến môi trường
# Chép file này thành .env.local rồi điền giá trị của bạn.
# TUYỆT ĐỐI không commit .env.local lên git.
# ===========================================================

# ---------- Firebase Web SDK (hiển thị công khai, lấy từ Firebase Console) ----------
# Project settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ten-du-an.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ten-du-an
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ten-du-an.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin SDK (bí mật — chỉ dùng ở server) ----------
# Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=ten-du-an
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ten-du-an.iam.gserviceaccount.com
# Dán nguyên chuỗi private_key trong file JSON, giữ các ký tự \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------- Gmail SMTP (gửi email đơn hàng + OTP) ----------
# Bật 2-Step Verification → https://myaccount.google.com/apppasswords → tạo App password 16 ký tự
GMAIL_USER=cua-hang-cua-ban@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Email nhận thông báo đơn mới (mặc định dùng GMAIL_USER nếu để trống)
MAIL_TO=cua-hang-cua-ban@gmail.com

# ---------- Quản trị ----------
# Danh sách email quản trị, cách nhau bằng dấu phẩy (đăng nhập bằng chính email này)
ADMIN_EMAILS=admin@gmail.com
# Chuỗi bí mật dùng để băm OTP, đặt một chuỗi ngẫu nhiên dài
OTP_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# ---------- Thông tin hiển thị trên website (công khai) ----------
NEXT_PUBLIC_BANK_NAME=MB Bank
NEXT_PUBLIC_BANK_ACCOUNT=0123456789
NEXT_PUBLIC_BANK_OWNER=NGUYEN VAN A
NEXT_PUBLIC_SITE_NAME=Mộng Nguyệt Studio

# ---------- Respan (tuỳ chọn — gợi ý xử lý đơn trong email cho shop) ----------
# Tạo API key tại https://platform.respan.ai → Gateway → API keys (chọn quyền Gateway).
# Chỉ dùng ở server, để trống thì email đơn mới vẫn gửi bình thường (không có phần gợi ý).
RESPAN_API_KEY=
# Tuỳ chọn: đổi model / endpoint của gateway
# RESPAN_MODEL=gpt-5.5
# RESPAN_BASE_URL=https://api.respan.ai/api
