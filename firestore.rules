rules_version = '2';

// Website chỉ đọc/ghi Firestore qua API route dùng Firebase Admin SDK
// (Admin SDK bỏ qua security rules). Trình duyệt không bao giờ truy cập trực tiếp,
// nên chặn toàn bộ để an toàn tuyệt đối.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
